# (On phones hidden files are awkward, so this file is called env.example.)
# Copy these NAMES into Render > Environment. Never commit real values.

# Neon connection string (Neon dashboard > Connect > copy). Starts with postgresql://
DATABASE_URL=

# Admin login. You choose these. Password: at least 10 characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Shop details
STORE_NAME=Super Mart
WHATSAPP=            # order WhatsApp number, e.g. 917025005875 (10 digits also works, +91 is added)
UPI_PHONE=           # UPI-registered phone number customers can pay to, e.g. 7025005875
UPI_ID=              # optional full UPI ID (name@bank). If set, a "Pay with UPI" button appears

# Server settings
NODE_ENV=production
TRUST_PROXY=1        # keep 1 on Render (needed for correct IP rate limiting)
SEED_DEMO=1          # 1 = add demo products on first start; 0 = start with an empty shop
